<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="./renderer/template/common.css">
    <link rel="stylesheet" href="./renderer/template/leaderboard_common.css">
    <style>
        .ship-table-row {
            justify-self: stretch;
            display: grid;
            justify-items: center;
            justify-content: space-between;
            padding: 0.4em 0 0.4em;
            grid-template-columns: 0.5fr 2.5fr 1fr 1fr 1.2fr 1fr 1fr;
            font-size: 0.9em;
            align-items: center;
        }
    </style>

</head>

<body>
    <div class="main">
        <section class="global-section">
            <div class="warship">{{ship.tier_roman}} {{ship.name}}</div>
            <img src='{{ship.icon}}'>
        </section>
        <div class="divider"></div>
        <section class="division-stats-section">
            <div class="division-stats-title">Leaderboard ({{region}})</div>
            <div class="per-ship-table">
                <div class="ship-table-row">
                    <div class="player-rank"></div>
                    <div class="per-ship-lbl per-ship-name">Player</div>
                    <div class="per-ship-lbl battles-label">Battles</div>
                    <div class="per-ship-lbl pr-label">PR</div>
                    <div class="per-ship-lbl winrate-label">Win rate</div>
                    <div class="per-ship-lbl avg-dmg-label">Dmg</div>
                    <div class="per-ship-lbl avg-frags-label">Frags</div>
                    {{!-- <div class="per-ship-lbl avg-planes-label">Planes</div> --}}
                </div>
                {{#players}}
                <div class="ship-table-row">
                    <div class="player-rank data" style="color: {{color}};">{{rank}}</div>
                    <div class="per-ship-name">
                        <span style="color: {{color}};">{{clan}}</span>
                        <span class="break" style="color: {{color}};">{{ign}}</span>
                    </div>
                    <div class="per-ship-battles data">{{battles}}</div>
                    <div class="per-ship-pr data" style="color: {{pr.color}};">{{pr.value}}</div>
                    <div class="per-ship-winrate data" style="color: {{winrate.color}}">{{winrate.value}}%</div>
                    <div class="per-ship-dmg data" style="color: {{dmg.color}};">{{dmg.value}}</div>
                    <div class="per-ship-frags data" style="color: {{frags.color}};">{{frags.value}}</div>
                    <div class="per-ship-planes data" style="color: {{planes.color}};">{{planes.value}}</div>
                </div>
                {{/players}}
            </div>

            <!-- <div class="signature">[PANTS]B2U</div> -->
    </div>
</body>

</html>
<script>
    // round corner stuff
    let arr_ship_data = document.getElementsByClassName('ship-table-row');
    for (let i = 0; i < arr_ship_data.length; i++) {
        if (i % 2 != 0 && i == (arr_ship_data.length - 1)) {
            arr_ship_data[i].style.backgroundColor = "#393939";
            arr_ship_data[i].style.borderBottomLeftRadius = "10px";
            arr_ship_data[i].style.borderBottomRightRadius = "10px";
        } else if (i % 2 != 0) {
            arr_ship_data[i].style.backgroundColor = "#393939";
        }
    }
</script>
<script>
    // round main height
    window.addEventListener("load", () => {
        let main = document.querySelector('.main');
        let height = main.offsetHeight - 1;
        main.style.height = height;
    })
</script>